{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm"
  },
  "newProjectRoot": "projects",
  "projects": {
    "PrivKnife": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "stylePreprocessorOptions": {
              "includePaths": [
                "src/styles"
              ]
            },
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              },
              {
                "glob": "worker.min.js",
                "input": "node_modules/tesseract.js/dist",
                "output": "/assets/ocr"
              },
              {
                "glob": "tesseract-core-lstm.wasm.js",
                "input": "node_modules/tesseract.js-core",
                "output": "/assets/ocr"
              },
              {
                "glob": "**/*",
                "input": "node_modules/pdfjs-dist/standard_fonts",
                "output": "/assets/pdf/standard-fonts"
              },
              {
                "glob": "**/*",
                "input": "node_modules/pdfjs-dist/wasm",
                "output": "/assets/pdf/wasm"
              },
              {
                "glob": "eng.traineddata.gz",
                "input": "node_modules/@tesseract.js-data/eng/4.0.0_best_int",
                "output": "/assets/ocr/lang"
              },
              {
                "glob": "spa.traineddata.gz",
                "input": "node_modules/@tesseract.js-data/spa/4.0.0_best_int",
                "output": "/assets/ocr/lang"
              },
              {
                "glob": "fra.traineddata.gz",
                "input": "node_modules/@tesseract.js-data/fra/4.0.0_best_int",
                "output": "/assets/ocr/lang"
              },
              {
                "glob": "deu.traineddata.gz",
                "input": "node_modules/@tesseract.js-data/deu/4.0.0_best_int",
                "output": "/assets/ocr/lang"
              },
              {
                "glob": "ita.traineddata.gz",
                "input": "node_modules/@tesseract.js-data/ita/4.0.0_best_int",
                "output": "/assets/ocr/lang"
              },
              {
                "glob": "por.traineddata.gz",
                "input": "node_modules/@tesseract.js-data/por/4.0.0_best_int",
                "output": "/assets/ocr/lang"
              },
              {
                "glob": "encoder.wasm",
                "input": "node_modules/woff2-encode-wasm/dist",
                "output": "/assets/woff2"
              },
              {
                "glob": "qpdf.wasm",
                "input": "node_modules/@neslinesli93/qpdf-wasm/dist",
                "output": "/assets/wasm"
              }
            ],
            "styles": [
              "src/styles.scss"
            ],
            "externalDependencies": [
              "fs",
              "path"
            ],
            "allowedCommonJsDependencies": [
              "@neslinesli93/qpdf-wasm"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "340kB",
                  "maximumError": "500kB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "6kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all",
              "optimization": {
                "scripts": true,
                "styles": {
                  "minify": true,
                  "inlineCritical": false
                },
                "fonts": true
              }
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "PrivKnife:build:production"
            },
            "development": {
              "buildTarget": "PrivKnife:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test"
        }
      }
    }
  }
}
