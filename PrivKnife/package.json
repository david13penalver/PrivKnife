{
  "name": "priv-knife",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test --watch=false --coverage --coverage-include=src/app/tools/**/*.component.ts --coverage-include=src/app/tools/**/engine.ts --coverage-include=src/app/tools/**/worker.ts --coverage-include=src/app/tools/tool-registry.ts --coverage-exclude=**/*.spec.ts --coverage-exclude=**/test-fixtures.ts --coverage-reporters=text-summary --coverage-reporters=json-summary && node qa/coverage-manifest.mjs",
    "qa:test": "node --test qa/*.test.mjs",
    "qa:smoke": "node qa/smoke.mjs --language en --width 390",
    "qa:smoke:es": "node qa/smoke.mjs --language es --width 390",
    "qa:coverage": "node qa/coverage-manifest.mjs",
    "qa:secure-preview": "node qa/secure-preview.mjs",
    "qa:resource-lifecycle": "node qa/resource-lifecycle.mjs",
    "qa:security:browser": "node qa/security-browser.mjs",
    "qa:bundle-budget": "node qa/bundle-budget.mjs"
  },
  "private": true,
  "packageManager": "npm@11.19.0",
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@breezystack/lamejs": "^1.2.7",
    "@types/jsbarcode": "^3.11.4",
    "@types/jspdf": "^1.3.3",
    "@types/qrcode": "^1.5.6",
    "dompurify": "3.4.16",
    "jsbarcode": "^3.12.3",
    "jspdf": "^4.2.1",
    "jsqr": "^1.4.0",
    "jszip": "^3.10.2",
    "marked": "^18.1.0",
    "papaparse": "^5.7.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "qrcode": "^1.5.4",
    "rxjs": "~7.8.0",
    "three": "^0.186.1",
    "three-bvh-csg": "^0.0.18",
    "tslib": "^2.3.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@angular/build": "^22.1.7",
    "@angular/cli": "^22.1.7",
    "@angular/compiler-cli": "^22.1.0",
    "@types/jszip": "^3.4.0",
    "@types/papaparse": "^5.5.2",
    "@types/three": "^0.186.0",
    "@vitest/coverage-v8": "^4.1.11",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "puppeteer-core": "^25.14.0",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  }
}
